# Copy this file to .env, then load it in your shell before starting Flask.
SECRET_KEY=replace-with-a-long-random-value

# Standalone LLM gateway configuration
LLM_PROVIDER=shanghaitech
LLM_API_ENDPOINT=https://genaiapi.shanghaitech.edu.cn/api/v1/start
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=GPT-5.5
LLM_DEPLOYMENT=east-US-2-gpt-5.5
LLM_API_STYLE=auto

# Recommended by OpenAlex for the polite request pool
OPENALEX_EMAIL=your-email@example.com

